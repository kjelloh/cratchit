# Writes OUT, a C++ file with the time of this build and the build type (CONFIG).
# Run with cmake -P on every build (target cratchit_build_stamp), so that the time
# is the time of the build and not of the last change to some source file.
string(TIMESTAMP built "%H:%M:%S %Y-%m-%d") # local time
file(WRITE "${OUT}" "// Generated by cmake/build_stamp.cmake on every build. Do not edit.
#include \"core/build_stamp.hpp\"

namespace cratchit {

std::string_view build_time() { return \"${built}\"; }
std::string_view build_type() { return \"${CONFIG}\"; }

} // namespace cratchit
")
